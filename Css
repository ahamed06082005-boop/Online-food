* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
  background: #fff8f0;
  color: #333;
  line-height: 1.5;
}

.hidden { display: none !important; }

/* Navbar */
.navbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 40px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}
.logo { font-size: 26px; color: #333; }
.logo span { color: #e8541e; }
.navbar nav a {
  margin: 0 14px;
  text-decoration: none;
  color: #333;
  font-weight: 600;
}
.navbar nav a:hover { color: #e8541e; }
.cart-btn {
  background: #e8541e;
  color: #fff;
  border: none;
  padding: 10px 18px;
  border-radius: 25px;
  cursor: pointer;
  font-weight: 600;
}

/* Hero */
.hero {
  background: linear-gradient(120deg, #e8541e, #f9a03f);
  color: #fff;
  padding: 90px 40px;
  text-align: center;
}
.hero h2 { font-size: 38px; margin-bottom: 12px; }
.hero p { font-size: 18px; margin-bottom: 24px; }

.btn {
  display: inline-block;
  background: #e8541e;
  color: #fff;
  border: none;
  padding: 12px 28px;
  border-radius: 25px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.2s;
}
.btn:hover { background: #c4410f; }
.hero .btn { background: #fff; color: #e8541e; }

/* Sections */
.container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
.section-title {
  text-align: center;
  font-size: 30px;
  margin-bottom: 24px;
  color: #e8541e;
}

/* Controls */
.controls { text-align: center; margin-bottom: 24px; }
#search {
  width: 100%;
  max-width: 420px;
  padding: 12px 18px;
  border: 2px solid #e8541e;
  border-radius: 25px;
  font-size: 16px;
  outline: none;
}
.filters { margin-top: 16px; }
.filter-btn {
  background: #fff;
  border: 2px solid #e8541e;
  color: #e8541e;
  padding: 8px 18px;
  margin: 4px;
  border-radius: 20px;
  cursor: pointer;
  font-weight: 600;
}
.filter-btn.active, .filter-btn:hover { background: #e8541e; color: #fff; }

/* Menu grid */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 22px;
}
.card {
  background: #fff;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
  transition: transform 0.2s;
}
.card:hover { transform: translateY(-5px); }
.card-img {
  height: 130px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64px;
  background: #fff0e0;
}
.card-body { padding: 16px; }
.card-body h3 { font-size: 18px; margin-bottom: 4px; }
.tag {
  display: inline-block;
  font-size: 12px;
  background: #ffe3cf;
  color: #c4410f;
  padding: 2px 10px;
  border-radius: 10px;
  margin-bottom: 8px;
}
.card-bottom { display: flex; justify-content: space-between; align-items: center; }
.price { font-size: 18px; font-weight: 700; color: #e8541e; }
.add-btn {
  background: #e8541e;
  color: #fff;
  border: none;
  padding: 8px 16px;
  border-radius: 18px;
  cursor: pointer;
  font-weight: 600;
}
.add-btn:hover { background: #c4410f; }
#no-result { text-align: center; font-size: 18px; margin-top: 20px; }

/* Cart */
.cart-box {
  background: #fff;
  padding: 24px;
  border-radius: 14px;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}
.cart-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #eee;
  flex-wrap: wrap;
  gap: 8px;
}
.qty-controls button {
  width: 30px;
  height: 30px;
  border: none;
  border-radius: 50%;
  background: #e8541e;
  color: #fff;
  font-size: 18px;
  cursor: pointer;
}
.qty-controls span { margin: 0 10px; font-weight: 700; }
.remove-btn {
  background: none;
  border: none;
  color: #d00;
  cursor: pointer;
  font-weight: 600;
}
.empty-cart { text-align: center; color: #888; padding: 20px; }
.cart-summary { text-align: right; margin-top: 18px; }
.cart-summary p { margin-bottom: 6px; }
.cart-summary .total { font-size: 20px; margin: 10px 0 14px; }

/* Checkout form */
.form {
  max-width: 520px;
  margin: 0 auto;
  background: #fff;
  padding: 26px;
  border-radius: 14px;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.form input, .form textarea, .form select {
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 8px;
  font-size: 15px;
  font-family: inherit;
}
.form textarea { min-height: 80px; resize: vertical; }
.error { color: #d00; font-size: 14px; min-height: 18px; }

/* Confirmation */
.confirm-box {
  max-width: 560px;
  margin: 0 auto;
  background: #fff;
  padding: 32px;
  border-radius: 14px;
  text-align: center;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}
.confirm-box h2 { color: #2e9e4f; margin-bottom: 12px; }
#confirm-summary { margin: 18px 0; text-align: left; }

footer {
  background: #333;
  color: #fff;
  text-align: center;
  padding: 18px;
  margin-top: 40px;
}

@media (max-width: 600px) {
  .navbar { padding: 12px 16px; flex-wrap: wrap; gap: 8px; }
  .hero h2 { font-size: 26px; }
}
