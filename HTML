<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FoodieHub - Online Food Ordering</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="navbar">
    <h1 class="logo">Foodie<span>Hub</span></h1>
    <nav>
      <a href="#home">Home</a>
      <a href="#menu">Menu</a>
      <a href="#cart-section">Cart</a>
    </nav>
    <button id="cart-btn" class="cart-btn">Cart (<span id="cart-count">0</span>)</button>
  </header>

  <section id="home" class="hero">
    <div class="hero-text">
      <h2>Hungry? Order your favourite food online</h2>
      <p>Fresh, hot and delivered to your doorstep in 30 minutes.</p>
      <a href="#menu" class="btn">Order Now</a>
    </div>
  </section>

  <main>
    <section id="menu" class="container">
      <h2 class="section-title">Our Menu</h2>
      <div class="controls">
        <input type="text" id="search" placeholder="Search food items...">
        <div class="filters" id="filters">
          <button class="filter-btn active" data-category="All">All</button>
          <button class="filter-btn" data-category="Biryani">Biryani</button>
          <button class="filter-btn" data-category="Meals">Meals</button>
          <button class="filter-btn" data-category="Snacks">Snacks</button>
          <button class="filter-btn" data-category="Drinks">Drinks</button>
        </div>
      </div>
      <div id="menu-grid" class="grid"></div>
      <p id="no-result" class="hidden">No food items found.</p>
    </section>

    <section id="cart-section" class="container">
      <h2 class="section-title">Your Cart</h2>
      <div class="cart-box">
        <div id="cart-items"></div>
        <div class="cart-summary">
          <p>Subtotal: <strong id="subtotal">Rs. 0</strong></p>
          <p>Delivery Fee: <strong id="delivery">Rs. 0</strong></p>
          <p class="total">Total: <strong id="total">Rs. 0</strong></p>
          <button id="checkout-btn" class="btn">Proceed to Checkout</button>
        </div>
      </div>
    </section>

    <section id="checkout" class="container hidden">
      <h2 class="section-title">Checkout</h2>
      <form id="checkout-form" class="form">
        <input type="text" id="name" placeholder="Full Name" required>
        <input type="tel" id="phone" placeholder="Phone Number (10 digits)" required>
        <textarea id="address" placeholder="Delivery Address" required></textarea>
        <select id="payment" required>
          <option value="">Select Payment Method</option>
          <option>Cash on Delivery</option>
          <option>UPI</option>
          <option>Card</option>
        </select>
        <p id="form-error" class="error"></p>
        <button type="submit" class="btn">Place Order</button>
      </form>
    </section>

    <section id="confirmation" class="container hidden">
      <div class="confirm-box">
        <h2>Order Placed Successfully!</h2>
        <p id="confirm-text"></p>
        <div id="confirm-summary"></div>
        <button id="new-order" class="btn">Order Again</button>
      </div>
    </section>
  </main>

  <footer>
    <p>&copy; 2026 FoodieHub. All rights reserved.</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
